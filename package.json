{
  "name": "peakora-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx wrangler pages dev . --port 3000",
    "deploy:worker": "cd worker && npx wrangler deploy",
    "deploy:pages": "npx wrangler pages deploy . --project-name peakora-assistant",
    "db:init": "cd worker && npx wrangler d1 execute peakora-db --remote --file=schema.sql",
    "build": "echo 'No build step needed'",
    "test": "node --test \"tests/*.test.js\""
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "web-push": "^3.6.7"
  }
}
