# Peakora Environment Variables

# Paddle Billing / Checkout Integration Credentials
PADDLE_CLIENT_TOKEN=
PADDLE_ENVIRONMENT=sandbox
PADDLE_MONTHLY_PRICE_ID=
PADDLE_YEARLY_PRICE_ID=

# Paddle Webhook signature secret (from Paddle dashboard > Notifications)
PADDLE_WEBHOOK_SECRET=

# Protects /api/stats, /api/subscribers, /api/feedback, /api/push-broadcast
ADMIN_TOKEN=

# Web Push subject (your contact mailto:)
VAPID_SUBJECT=mailto:peakora.network@gmail.com
