# Peakora Environment Variables

# Dodo Payments / Checkout Integration (Merchant of Record)
# Test mode while integrating; switch to live_mode for production.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_LIVE_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_MONTHLY_PRODUCT_ID=
DODO_YEARLY_PRODUCT_ID=

# Dodo webhook signing secret (from Dodo dashboard > Developer > Webhooks)
DODO_PAYMENTS_WEBHOOK_SECRET=

# Public base URL of the deployed site (used for checkout return_url).
# e.g. https://peakora.life
APP_PUBLIC_URL=

# The Cloudflare Worker origin that server.js proxies billing + subscription
# status through (the Worker + D1 is the single source of truth for billing).
# Only needed for the Node/Docker deploy path; the Pages frontend talks to the
# Worker directly. e.g. https://peakora-api.peakora.workers.dev
WORKER_ORIGIN=https://peakora-api.peakora.workers.dev

# Protects /api/stats, /api/subscribers, /api/feedback, /api/push-broadcast
# Also protects /affiliate/admin/* (partner management) and signs partner
# portal login tokens (x-affiliate-token HMAC over email|expiry).
ADMIN_TOKEN=

# Web Push subject (your contact mailto:)
VAPID_SUBJECT=mailto:peakora.network@gmail.com

# ── Affiliate Program ──────────────────────────────────────────────────────
# These are advisory/price-snapshot values used for earnings sanity checks;
# authoritative commission tiers live in worker/src/affiliate.js (DEFAULT_TIERS)
# and authoritative prices live in the Dodo product config above.
AFFILIATE_DEFAULT_COOKIE_DAYS=90
AFFILIATE_PAYOUT_HOLD_DAYS=30
AFFILIATE_MONTHLY_PRICE=9.99
AFFILIATE_YEARLY_PRICE=95.88
