# Peakora Environment Variables

# Dodo Payments / Checkout Integration (Merchant of Record)
# Test mode while integrating; switch to live_mode for production.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_MONTHLY_PRODUCT_ID=
DODO_YEARLY_PRODUCT_ID=

# Dodo webhook signing secret (from Dodo dashboard > Developer > Webhooks)
DODO_PAYMENTS_WEBHOOK_SECRET=

# Public base URL of the deployed site (used for checkout return_url).
# e.g. https://peakora.life
APP_PUBLIC_URL=

# Protects /api/stats, /api/subscribers, /api/feedback, /api/push-broadcast
ADMIN_TOKEN=

# Web Push subject (your contact mailto:)
VAPID_SUBJECT=mailto:peakora.network@gmail.com
